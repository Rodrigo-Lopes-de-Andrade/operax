# Path 1 of the front/back contract: the browser reads non-sensitive aggregates
# straight from Supabase with the anon key. RLS filters tenant and scope.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Path 2: individual, sensitive or write access goes through FastAPI, which
# validates the Supabase access token and re-checks role and scope.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Application errors only.
NEXT_PUBLIC_SENTRY_DSN=

# There is no service_role key here, and there never will be: it lives in the
# backend alone (CLAUDE.md, "O que NAO tocar" and the security rules).
