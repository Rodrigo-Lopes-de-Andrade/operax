# OperaX backend — copy to backend/.env and fill in. Never commit real values.
# A missing required variable stops the process at startup, on purpose.

# --- Required ---------------------------------------------------------------
# Direct Postgres connection (psycopg). Supabase > Project Settings > Database.
DATABASE_URL=
SUPABASE_URL=
# service_role lives here and nowhere else: never in Next.js, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# JWKS of the project, used to validate the Supabase access token.
SUPABASE_JWT_JWKS_URL=

# At least one LLM provider key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Optional ---------------------------------------------------------------
# Exact origins of the dashboard, comma separated. "*" is rejected: the API
# answers with credentials.
CORS_ORIGINS=http://localhost:3000

SENTRY_DSN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- Not environment variables ----------------------------------------------
# Secullum credentials and the WhatsApp provider token are per tenant: they live
# in the Supabase Vault, referenced by app.integration_secret.
